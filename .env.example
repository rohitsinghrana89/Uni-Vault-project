# UniVault Environment Variables
# ================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control — it is already in .gitignore.

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.rlxyyrx.mongodb.net/univault?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.rlxyyrx.mongodb.net/univault?retryWrites=true&w=majority&appName=Cluster0

# JWT Authentication Secret
JWT_SECRET=your_secure_jwt_secret_key_here

# Server Configuration
PORT=5000
NODE_ENV=production

# TMDB (The Movie Database) API Configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3
